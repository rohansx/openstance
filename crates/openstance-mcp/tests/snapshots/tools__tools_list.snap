---
source: crates/openstance-mcp/tests/tools.rs
expression: tools
---
[
  {
    "name": "search_people",
    "description": "Search the user's own relationship graph (local, free). Returns people ranked by text relevance lifted by relationship score, with dated evidence. Filters you set are echoed back in `query`; edit and rerun instead of rephrasing.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "free text, e.g. 'fintech founders I met'"
        },
        "company": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "location": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industry": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "soft: boosts relevance, never excludes"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "exact match on the user's tags"
        },
        "since": {
          "type": "string",
          "description": "had an interaction on or after: YYYY, YYYY-MM, YYYY-MM-DD or 90d/6m/1y"
        },
        "until": {
          "type": "string",
          "description": "had an interaction before this date (with since: inside the window)"
        },
        "last_contact_before": {
          "type": "string",
          "description": "last contact strictly before this date (\"haven't talked since\")"
        },
        "met_in_person": {
          "type": "boolean"
        },
        "replied": {
          "type": "boolean"
        },
        "min_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lost_touch": {
          "type": "boolean",
          "description": "high frequency, low recency"
        },
        "include_bulk": {
          "type": "boolean",
          "default": false
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "parse": {
          "type": "boolean",
          "default": true,
          "description": "run the query parser on text; false = take text and filters literally (search.md no_parse)"
        },
        "explain": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_person",
    "description": "Look up one person in the user's own relationship graph (local, free): fields and where each came from, the relationship score with its five components, identities, recent interactions and the strongest mutual connections. An ambiguous name returns an `ambiguous` error with candidates; ask the user which one and call again with the id.",
    "inputSchema": {
      "type": "object",
      "required": [
        "person"
      ],
      "properties": {
        "person": {
          "type": "string",
          "description": "id, email, linkedin url/slug, @x_handle, or name"
        },
        "interactions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "default": 10
        },
        "mutuals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "default": 10
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "how_connected",
    "description": "Find warm introduction paths to someone already in the user's graph (local, free). Each path goes through a mutual connection: strength = the user's score with the mutual x the mutual's tie to the target, with dated evidence. Returns `found: false` when the target is not in the graph.",
    "inputSchema": {
      "type": "object",
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string",
          "description": "person id, email, linkedin, or name (must be in the graph; use path_to for strangers)"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "path_to",
    "description": "Find warm intro paths to a person, including people not in the graph. Local steps are free. Looking up a stranger's employers or email costs money: call with allow_egress=false first, show the user the quote, and only then call with allow_egress=true.",
    "inputSchema": {
      "type": "object",
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string",
          "description": "name, email, linkedin url, or person id"
        },
        "company": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "find_email": {
          "type": "boolean",
          "default": false
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "allow_egress": {
          "type": "boolean",
          "default": false
        },
        "max_usd": {
          "type": "number",
          "minimum": 0
        },
        "plan_only": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "brief",
    "description": "Write a short, fact-only intro brief about one person in the user's graph: who they are, how the user knows them, last contact, the best mutual and a suggested opener. Local and free unless web=true, which adds one paid web search: call with allow_egress=false first, show the user the quote, and only then call with allow_egress=true.",
    "inputSchema": {
      "type": "object",
      "required": [
        "person"
      ],
      "properties": {
        "person": {
          "type": "string"
        },
        "web": {
          "type": "boolean",
          "default": false,
          "description": "one web search for recent public posts (costs money)"
        },
        "allow_egress": {
          "type": "boolean",
          "default": false
        },
        "max_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "list_views",
    "description": "List shared views (local, free): the user's own saved views and the encrypted views other people sent them. `direction` filters own, imported or all.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "direction": {
          "enum": [
            "own",
            "imported",
            "all"
          ],
          "default": "all"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "search_view",
    "description": "Search a view someone shared with the user (local, free). These people are not in the user's own graph; each result names the view and its claimed owner. Use '*' to search every imported, unexpired view.",
    "inputSchema": {
      "type": "object",
      "required": [
        "view"
      ],
      "properties": {
        "view": {
          "type": "string",
          "description": "view name or id; '*' searches every imported, unexpired view"
        },
        "text": {
          "type": "string"
        },
        "company": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "quote_enrich",
    "description": "Price enrichment requests (profile, find_email, verify_email, company, web_search) with the configured backend. Never sends contact data and never spends; returns a Quote. People marked no_enrich come back under `skipped`.",
    "inputSchema": {
      "type": "object",
      "required": [
        "requests"
      ],
      "properties": {
        "requests": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "profile",
                  "find_email",
                  "verify_email",
                  "company",
                  "web_search"
                ]
              },
              "person_id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "company": {
                "type": "string"
              },
              "linkedin": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "query": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    }
  }
]
